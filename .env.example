# Copy this file to .env.local and fill values. Do NOT commit real secret keys.
# Keep SUPABASE_SERVICE_ROLE_KEY only in server-side env (do not expose to client).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-key
# SUPABASE_SERVICE_ROLE_KEY should be set in .env.local on your machine or in your deployment provider's secret store.
SUPABASE_SERVICE_ROLE_KEY=service-role-key-DO-NOT-COMMIT

# Optional: map provider token if using Mapbox (not required for OpenStreetMap/Leaflet)
NEXT_PUBLIC_MAPBOX_TOKEN=

NODE_ENV=development

# IMPORTANT: If you accidentally committed a secret, rotate it immediately and remove it from repository history.
